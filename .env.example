# Used by docker compose (host-side ports and app environment)
APP_PORT=8080
DB_PORT=5433
APP_ENV=dev

# Only needed when running the server or tests outside Docker (go run, go test).
# Without DATABASE_URL the server falls back to the in-memory store.
# ADDR=:8080
# DATABASE_URL=postgres://app:app@127.0.0.1:5433/shortener?sslmode=disable
# REDIS_URL=redis://localhost:6379
